(defn column-windows
  ([] (column-windows (:focused @niri-state)))
  ([win]
   (let [win-column (-> win :layout :pos_in_scrolling_layout first)]
     (->> (:windows @niri-state)
          (vals)
          (filter #(= (:workspace_id %) (:workspace_id win)))
          (filter #(= (-> % :layout :pos_in_scrolling_layout first) win-column))
          (sort-by #(-> % :layout :pos_in_scrolling_layout second))))))

(defn siblings
  ;; "siblings" are windows in the same column as you
  ([] (siblings (:focused @niri-state)))
  ([win] (remove #(= (:id %) (:id win)) (column-windows))))

(defn swap-or-move [dir]
  (if (edge? (:focused @niri-state) dir)
    (action (str "consume-or-expel-window-" dir))
    (action (str "swap-window-" dir) )))

;; this really depends on if you're focused right or left
(defn rotate []
  (action :move-column-left)
  (action :focus-column-right))

(defn rotate-reverse []
  (action :move-column-right)
  (action :focus-column-left))

(defn tabbed? [win]
  ;; todo: this smarter - maybe have a flag come through on tab keybinding and remember or something
  ;; this fails if untabbed and same proportions
  (let [siblings (siblings win)]
    (when-not (empty? siblings)
      (apply = (map #(-> % :layout :tile_size) siblings)))))

(defn cycle--next [current compare coll]
  (let [wids (concat wids [(first wids)])
        wids (if reverse? (reverse wids) wids)
        next-wid (cond
                   ((set wids) active-wid) (let [i (.indexOf wids active-wid)]
                                             (nth wids (inc i)))
                   (= (:app_id last-active-window) class) (:id last-active-window)
                   :else (first wids))]))

(defn cycle- [reverse? kind & args]
  (let [focus (fn [wids]
                (let [wids (map :id wids)
                      active-wid (:id (:focused @niri-state))
                      wids (concat wids [(first wids)])
                      wids (if reverse? (reverse wids) wids)]
                  (action :focus-window "--id"
                          (if ((set wids) active-wid) (let [i (.indexOf (vec wids) active-wid)]
                                                        (nth wids (inc i)))
                              (first wids)))))
        act (fn [wids] (if (empty? wids)
                         "EXITCODE=1"
                         (do (focus wids)
                             (action :center-window) ; todo: revisit
                             "EXITCODE=0")))]
    (act (condp = (keyword kind)
           :column (column-windows)
           :class (->> (vals (:windows @niri-state))
                       (filter (fn [w]
                                 (re-matches (re-pattern (first args))
                                             (last (string/split (:app_id w) #"\."))))))

           ;; current workspace
           :class-workspace (->> (vals (:windows @niri-state))
                                 (filter (fn [w]
                                           (and (= (:workspace_id (:focused @niri-state) ) (:workspace_id w))
                                                (re-matches (re-pattern (first args))
                                                            (last (string/split (:app_id w) #"\.")))))))))))

(defn cycle [& args] (apply cycle- false args))

(defn cycle-reverse [& args] (apply cycle- true args))

