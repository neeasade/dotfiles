  (defn edge?
    ([dir] )
    ([win dir]
     (when-not (nil? win)
       (if (-> @niri-state :focused :is_floating)
         false
         (let [win-column (-> win :layout :pos_in_scrolling_layout first)
               columns (->> (:windows @niri-state)
                            (vals)
                            (filter #(= (:workspace_id %) (:workspace_id win)))
                            (map #(-> % :layout :pos_in_scrolling_layout first))
                            (distinct)
                            (sort)
                            )]
           (condp = dir
             "left" (= (first columns) win-column)
             "right" (= (last columns) win-column)
             (println "edge? what")))))))

  ;; (:workspaces :focused-window-id :windows :workspace-active-windows)

  (keys
   (first
    (:workspaces @niri-state)))

  (keys @niri-state)

  (vals (:windows @niri-state))

  (siblings)

  (:focused @niri-state)

  (edge? )

  (edge? "left")

  (:workspace-active-windows @niri-state)

  )
